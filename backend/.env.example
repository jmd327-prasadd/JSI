# Copy to backend/.env for local (non-docker) development.
# In docker-compose these are set directly in docker-compose.yml instead.

JQA_DATABASE_URL=sqlite:///./jqa_dev.db
JQA_DATA_DIR=./data

# Azure OpenAI (AI orchestration layer -- not yet wired up in this build)
JQA_AZURE_OPENAI_ENDPOINT=
JQA_AZURE_OPENAI_API_KEY=
JQA_AZURE_OPENAI_API_VERSION=2024-08-01-preview
JQA_AZURE_OPENAI_DEPLOYMENT_FAST=
JQA_AZURE_OPENAI_DEPLOYMENT_REASONING=
